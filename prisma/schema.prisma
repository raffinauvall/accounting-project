generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  FINANCE
  VIEWER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum StatementType {
  BALANCE_SHEET
  PROFIT_LOSS
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum PeriodStatus {
  OPEN
  CLOSED
}

enum AuditAction {
  CREATE_COA
  UPDATE_COA
  DELETE_COA
  DEACTIVATE_COA
  CREATE_ENTRY
  UPDATE_ENTRY
  CLOSE_PERIOD
  IMPORT_JOURNAL
}

model Organization {
  id                  String                @id @default(cuid())
  name                String                @db.VarChar(150)
  slug                String                @unique @db.VarChar(80)
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  users               User[]
  coaAccounts         CoaAccount[]
  accountingPeriods   AccountingPeriod[]
  entries             CoaEntry[]
  journalTransactions JournalTransaction[]
  inventoryItems      InventoryItem[]
  auditLogs           AuditLog[]
  organizationAccesses UserOrganization[]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique @db.VarChar(255)
  name         String     @db.VarChar(150)
  passwordHash String
  role         Role       @default(VIEWER)
  organizationId String?
  canViewConsolidated Boolean @default(false)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  entries      CoaEntry[] @relation("EntryCreatedBy")
  journalTransactions JournalTransaction[] @relation("JournalCreatedBy")
  auditLogs    AuditLog[] @relation("AuditActor")
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationAccesses UserOrganization[]

  @@index([organizationId])
}

model CoaAccount {
  id               String        @id @default(cuid())
  organizationId   String        @default("default-org")
  code             String        @db.VarChar(50)
  name             String        @db.VarChar(150)
  parentId         String?
  accountType      AccountType
  statementType    StatementType
  normalBalance    NormalBalance
  isActive         Boolean       @default(true)
  isPostingAccount Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  parent           CoaAccount?   @relation("CoaHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children         CoaAccount[]  @relation("CoaHierarchy")
  entries          CoaEntry[]
  journalTransactions JournalTransaction[]
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([parentId])
  @@index([organizationId])
  @@unique([organizationId, code])
}

model AccountingPeriod {
  id        String       @id @default(cuid())
  organizationId String   @default("default-org")
  month     Int          @db.SmallInt
  year      Int          @db.SmallInt
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  status    PeriodStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  entries   CoaEntry[]
  journalTransactions JournalTransaction[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, month, year])
  @@index([organizationId])
  @@index([year, month])
}

model CoaEntry {
  id                 String           @id @default(cuid())
  organizationId     String           @default("default-org")
  coaAccountId       String
  accountingPeriodId String
  amount             Decimal          @db.Decimal(19, 2)
  description        String?          @db.VarChar(500)
  createdById        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  coaAccount         CoaAccount       @relation(fields: [coaAccountId], references: [id], onDelete: Restrict)
  accountingPeriod   AccountingPeriod @relation(fields: [accountingPeriodId], references: [id], onDelete: Restrict)
  createdBy          User             @relation("EntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, coaAccountId, accountingPeriodId])
  @@index([organizationId])
  @@index([accountingPeriodId])
  @@index([coaAccountId])
}

model JournalTransaction {
  id                 String           @id @default(cuid())
  organizationId     String           @default("default-org")
  transactionDate    DateTime         @db.Date
  accountingPeriodId String
  coaAccountId       String
  inventoryItemId    String?
  inventoryQuantity  Decimal          @default(0) @db.Decimal(19, 3)
  offerNumber        String?          @db.VarChar(100)
  invoiceNumber      String?          @db.VarChar(100)
  description        String?          @db.VarChar(500)
  credit             Decimal          @default(0) @db.Decimal(19, 2)
  debit              Decimal          @default(0) @db.Decimal(19, 2)
  importKey          String           @db.VarChar(100)
  sourceRow          Int
  createdById        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  accountingPeriod   AccountingPeriod @relation(fields: [accountingPeriodId], references: [id], onDelete: Restrict)
  coaAccount         CoaAccount       @relation(fields: [coaAccountId], references: [id], onDelete: Restrict)
  createdBy          User             @relation("JournalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  inventoryItem      InventoryItem?   @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, importKey])
  @@index([organizationId])
  @@index([accountingPeriodId])
  @@index([coaAccountId])
  @@index([transactionDate])
  @@index([inventoryItemId])
}

model InventoryItem {
  id                 String              @id @default(cuid())
  organizationId     String              @default("default-org")
  name               String              @db.VarChar(150)
  unit               String              @db.VarChar(30)
  openingStock       Decimal             @default(0) @db.Decimal(19, 3)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  journalTransactions JournalTransaction[]
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model AuditLog {
  id        String      @id @default(cuid())
  organizationId String?
  userId    String
  action    AuditAction
  entity    String      @db.VarChar(80)
  entityId  String      @db.VarChar(100)
  metadata  Json?       @db.JsonB
  createdAt DateTime    @default(now())
  user      User        @relation("AuditActor", fields: [userId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model UserOrganization {
  userId         String
  organizationId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
}
